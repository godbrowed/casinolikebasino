# Database (use a fresh DATABASE_URL too if PugGift must have empty balances/history)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# New Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_NEW_BOT_TOKEN
TELEGRAM_BOT_USERNAME=PugGiftBot
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret
TELEGRAM_WEBAPP_URL=https://your-production-domain.example
NEXT_PUBLIC_APP_URL=https://your-production-domain.example

# App/server security — generate different long random values
SESSION_SECRET=replace_with_a_long_random_session_secret
ADMIN_SECRET=replace_with_a_long_random_admin_secret
CRON_SECRET=replace_with_a_long_random_cron_secret
ADMIN_TELEGRAM_IDS=123456789
ENABLE_DEMO_AUTH=false

# Optional channel required for daily rewards (without @)
DAILY_CHANNEL_USERNAME=puggift
NEXT_PUBLIC_DAILY_CHANNEL_USERNAME=puggift

# TON deposits
TON_RECEIVER_ADDRESS=UQ_REPLACE_WITH_YOUR_TON_WALLET
TONCENTER_API_KEY=replace_with_toncenter_api_key

# Telegram gift deposits through a normal account (no Business connection).
# RELAYER_USER_ID is the numeric Telegram ID of @pugsrelayer. It can be omitted
# after that account has opened PugGift once, letting the app resolve it by username.
RELAYER_USERNAME=pugsrelayer
RELAYER_USER_ID=
# Optional: only automatic gift withdrawals still require a Business connection.
TELEGRAM_BUSINESS_CONNECTION_ID=
